{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dictation-overlay",
  "version": "0.3.10",
  "identifier": "com.bayashi.dictation-overlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dictation-overlay",
        "width": 1200,
        "height": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 bayashi",
    "shortDescription": "Transparent caption overlay native helper for dictation-beta"
  }
}
